# Copia este archivo como .env.local (en tu PC) y agrega las mismas variables
# en Vercel: Project → Settings → Environment Variables.

# Dominio público de la web (sin / al final). En Vercel es opcional si usas el dominio .vercel.app
NEXT_PUBLIC_SITE_URL=https://bosqo.pe

# Correo de los formularios (contacto, newsletter, avísame y libro de reclamaciones) vía https://resend.com
# 1. Crea una cuenta gratuita y una API key.
# 2. Verifica tu dominio en Resend para enviar desde él (sin dominio solo puedes enviarte correos a ti mismo
#    usando CORREO_REMITENTE=onboarding@resend.dev).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CORREO_REMITENTE=BOSQO Web <web@bosqo.pe>
# Dónde quieres recibir los mensajes
CORREO_DESTINO=tu-correo@gmail.com

# Acceso al panel del CMS (/acceso). NO los escribas a mano: genéralos con
#   node scripts/crear-acceso.mjs
# que los guarda en .env.local. Solo hacen falta en tu PC (el CMS no existe en Vercel).
CMS_USUARIO=
CMS_CLAVE_HASH=
CMS_SECRETO=
