# Copia este archivo como .env.local (en tu PC) y agrega las mismas variables
# en Vercel: Project → Settings → Environment Variables.

# Dominio público de la web (sin / al final). En Vercel es opcional si usas el dominio .vercel.app
NEXT_PUBLIC_SITE_URL=https://bosqo.pe

# Correo de los formularios (contacto, newsletter, avísame y libro de reclamaciones) desde Gmail.
# 1. Activa la verificación en 2 pasos: https://myaccount.google.com/signinoptions/twosv
# 2. Crea una contraseña de aplicación:   https://myaccount.google.com/apppasswords
GMAIL_USUARIO=tu-cuenta@gmail.com
GMAIL_CLAVE_APP=abcd efgh ijkl mnop
# Dónde quieres recibir los mensajes (opcional: por defecto, la misma cuenta de Gmail)
CORREO_DESTINO=tu-correo@gmail.com

# Acceso al panel del CMS (/acceso), en tu PC y en Vercel. NO los escribas a mano: genéralos con
#   node scripts/crear-acceso.mjs
# que los guarda en .env.local; luego cópialos a Vercel.
CMS_USUARIO=
CMS_CLAVE_HASH=
CMS_SECRETO=

# CMS en la web publicada (Keystatic en modo GitHub). Los crea Keystatic al configurar la GitHub App
# (en local, con NEXT_PUBLIC_CMS_GITHUB=1) y los escribe en el archivo .env; luego cópialos a Vercel.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
